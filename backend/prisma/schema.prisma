generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ReportStatus {
  Pending
  PENDING_AI
  Approved
  In_Progress
  Resolved
  Rejected
}

enum Priority {
  Low
  Medium
  High
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String
  role      String
  createdAt DateTime @default(now())
  reports   Report[]
}

model Report {
  id              String       @id @default(uuid()) @db.Uuid
  title           String
  description     String
  category        String
  status          ReportStatus @default(Pending)
  priority        Priority     @default(Medium)
  locationAddress String
  latitude        Float
  longitude       Float
  photoUrl        String?
  parentReportId  String?      @db.Uuid
  parentReport    Report?      @relation("ReportDuplicates", fields: [parentReportId], references: [id], onDelete: Cascade)
  duplicates      Report[]     @relation("ReportDuplicates")
  isDuplicate     Boolean      @default(false)
  duplicateCount  Int          @default(0)
  aiProcessed     Boolean      @default(false)
  requiresHumanReview Boolean   @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  actionPlan      ActionPlan?
  auditLogs       AuditLog[]
  reporterId      String?      @db.Uuid
  reporter        User?        @relation(fields: [reporterId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([category])
  @@index([priority])
  @@index([parentReportId])
}

model ActionPlan {
  id             String   @id @default(uuid()) @db.Uuid
  reportId       String   @unique @db.Uuid
  targetAgency   String
  confidenceScore Float
  estimatedDays  Int
  actionSteps    Json
  confidenceMetadata Json?
  approvedBy     String?
  approvedAt     DateTime?
  createdAt      DateTime @default(now())
  report         Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  reportId  String   @db.Uuid
  action    String
  details   String
  timestamp DateTime @default(now())
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}
